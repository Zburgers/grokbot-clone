[Unit]
Description=Grokbot local desktop
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/local/libexec/grokbot/desktop-firewall.sh
ExecStart=/usr/bin/docker start grokbot-desktop
ExecStartPost=/usr/local/libexec/grokbot/desktop-hosts.sh
ExecStop=/usr/bin/docker stop -t 20 grokbot-desktop
TimeoutStartSec=45
TimeoutStopSec=30

[Install]
WantedBy=docker.service
