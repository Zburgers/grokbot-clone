# hivebot — desktop sidecar environment (/srv/stack/hivebot/desktop.env)
#
# Read ONLY by the `hivebot-desktop` service. Deliberately minimal: this is the
# container that runs shell commands and drives a browser, so it must not hold
# the model key, the Composio key, the session secret or the owner password hash.
# Do not merge this file into .env.

# Must equal DESKTOP_TOKEN in .env. The app sends it as a Bearer token; the
# daemon rejects every route except /health without it.
DESKTOP_TOKEN=

# Optional. Default in the image is 1280x800x24.
# RESOLUTION=1280x800x24
