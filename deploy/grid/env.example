# hivebot — application environment (/srv/stack/hivebot/.env)
#
# Place this file on the Grid host as /srv/stack/hivebot/.env, mode 640,
# owner deploy:deploy. It is read ONLY by the `hivebot` service. The desktop
# sidecar gets ./hivebot/desktop.env instead — see desktop.env.example.
#
# Values are never committed. Names only in this template.
# Quote OWNER_PASSWORD_HASH in single quotes so its `$` separators stay literal.

# ---- exposure (pilot: Tailscale address, plain HTTP) ----
HOST=0.0.0.0
PORT=8787
# Must match the URL a browser actually uses. The session cookie is marked
# Secure only when APP_URL starts with https, so these two change together at
# the public cutover.
APP_URL=http://100.71.130.57:8787
SERVER_URL=http://100.71.130.57:8787

# ---- owner (single tenant; this is the only account) ----
OWNER_EMAIL=
OWNER_NAME=
# node scripts/hash-password.mjs < /path/to/password-file   (form: scrypt$salt$key)
OWNER_PASSWORD_HASH=''

# ---- secrets ----
# openssl rand -hex 32
SESSION_SECRET=
# openssl rand -hex 32 — must equal DESKTOP_TOKEN in desktop.env
DESKTOP_TOKEN=

# ---- model (DeepSeek; the app needs an OpenAI Responses-API surface) ----
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# Optional cheaper model for memory/summaries and as a fallback.
LLM_FALLBACK_MODEL=
# DeepSeek has no hosted web_search / x_search tools. Leave empty.
LLM_BUILTIN_TOOLS=

# ---- computer ----
COMPUTER_PROVIDER=local
DESKTOP_URL=http://hivebot-desktop:8090

# ---- storage ----
DB_PATH=/data/grokbot.db

# ---- features off for the pilot ----
VOICE_ENABLED=0
GOOGLE_LOGIN=0
DEV_LOGIN=0
