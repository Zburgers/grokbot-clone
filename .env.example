# Local single-owner setup. Copy to .env, fill blanks, chmod 600 .env.
# Never commit credentials. Use a developer project key for Composio, not a consumer/MCP key.
LLM_BASE_URL=http://127.0.0.1:8317/v1
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
# Optional: set a fallback model available at your endpoint.
LLM_FALLBACK_MODEL=
# Hosted tools must be supported by your provider; leave empty to disable.
LLM_BUILTIN_TOOLS=web_search
COMPOSIO_API_KEY=
SESSION_SECRET=
# Generate SESSION_SECRET and DESKTOP_TOKEN separately with: openssl rand -hex 32
DESKTOP_TOKEN=
COMPUTER_PROVIDER=local
DESKTOP_URL=http://127.0.0.1:18090
HOST=127.0.0.1
PORT=8787
APP_URL=http://localhost:8787
SERVER_URL=http://localhost:8787
OWNER_EMAIL=owner@localhost
OWNER_NAME=Owner
# Generate with scripts/hash-password.mjs. Single-quote the value in .env.
OWNER_PASSWORD_HASH=
VOICE_ENABLED=0
GOOGLE_LOGIN=0
DEV_LOGIN=0
# Orgo is optional: COMPUTER_PROVIDER=orgo requires ORGO_API_KEY and optionally ORGO_WORKSPACE_ID.
# Native memory and MCP. Knowledge policy defaults to knowledge.json beside DB_PATH.
# GROKBOT_KNOWLEDGE_CONFIG=/absolute/private/path/knowledge.json
GROKBOT_COMPACT_TOKENS=70000
# Conservative guard after failed summarization; independent of the model context window.
GROKBOT_CONTEXT_MAX_TOKENS=140000
